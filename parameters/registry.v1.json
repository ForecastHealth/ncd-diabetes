        "source:gbd-2019-disability-weights"
      ]
    },
    {
      "parameter_id": "diabetic_nephropathy_disability_weight",
      "label": "Diabetic nephropathy disability weight",
      "meaning": "Chronic kidney disease due to type 2 diabetes (stage III 0 to 0.149 with anaemia, stage IV 0.104, stage V 0.569, dialysis 0.571) at the GBD 2019 global average: 1.69 million YLDs over 129.6 million cases.",
      "ownership_scope": "module_owned",
      "value_type": "number",
