        "source:gbd-2019-disability-weights"
      ]
    },
    {
      "parameter_id": "lower_extremity_amputation_disability_weight",
      "label": "Lower-extremity amputation disability weight",
      "meaning": "GBD sequelae diabetic neuropathy with treated amputation (0.17) and with untreated amputation (0.28), given equal shares because GBD splits them by health-system access and publishes no split.",
      "ownership_scope": "module_owned",
      "value_type": "number",
