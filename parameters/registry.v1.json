  "parameters": [
    {
      "parameter_id": "diabetes_disability_weight",
      "label": "Diabetes disability weight",
      "meaning": "Diabetes without a modelled complication (uncomplicated 0.049, neuropathy 0.133, foot ulcer and other sequelae) at the GBD 2019 global average for type 2 diabetes: 35.15 million YLDs over 437.9 million cases.",
      "ownership_scope": "module_owned",
      "value_type": "number",
      "editable_in_scenario": false,
      "shape": "scalar",
      "units": "disability weight",
      "default": {
        "value": 0.08,
        "source_ref": "source:gbd-2019-disability-weights"
      },
      "allowed_range": {
        "min": 0,
        "max": 1
      },
      "placement_refs": [
        {
          "kind": "json_path",
          "ref": "$.nodes[?(@.id=='lrso7mga')].generate_array.parameters.value"
        }
      ],
      "provenance_refs": [
        "source:gbd-2019-disability-weights"
      ]
    },
    {
      "parameter_id": "diabetic_retinopathy_disability_weight",
      "label": "Diabetic retinopathy disability weight",
      "meaning": "Vision loss due to diabetes: GBD moderate 0.031, severe 0.184 and blindness 0.187, given equal shares because GBD publishes no global severity split for diabetic vision loss.",
      "ownership_scope": "module_owned",
      "value_type": "number",
      "editable_in_scenario": false,
      "shape": "scalar",
      "units": "disability weight",
