    },
    {
      "channel_id": "incidence_modifier",
      "meaning": "Optional source-owned risk-factor modifier applied to diabetes incidence.",
      "shape": "yearly_2x101_or_scalar",
      "units": "multiplier",
      "required": false,
      "binding": {
        "legacy_lowering_ref": "$.links[?(@.id=='eYyocGwO')].compiler_binding"
