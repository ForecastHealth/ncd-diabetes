    {
      "channel_id": "background_mortality_rate",
      "meaning": "All-cause background mortality rate supplied by the demographic substrate.",
      "shape": "2x101",
      "units": "rate",
      "required": true,
      "owner_module_id": "demographic_substrate",
      "binding": {
        "legacy_lowering_refs": [
